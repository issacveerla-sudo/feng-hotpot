# ─────────────────────────────────────────────────────────────
# Feng Hotpot — Environment variables
# Copy this file to ".env.local" and fill in your Supabase values.
# (The app runs on seeded demo data even if you leave these blank.)
# ─────────────────────────────────────────────────────────────

# From Supabase: Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=

# From Supabase: Project Settings → API → Project API keys → "anon public"
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Comma-separated list of emails allowed into the owner dashboard (/admin).
# Example: owner@fenghotpot.com,manager@fenghotpot.com
NEXT_PUBLIC_ADMIN_EMAILS=owner@fenghotpot.com

# Where the "Order Now" button sends guests (your Uber Eats / ordering link).
NEXT_PUBLIC_ORDER_URL=https://www.ubereats.com/store/feng-hotpot-%E5%86%AF%E6%A0%A1%E9%95%BF%E8%80%81%E7%81%AB%E9%94%85-1669-hollenbeck-ave-a/07Y14L2GU8Sp8p-55mhtcw

# ── SMS waitlist texts (optional) ─────────────────────────────
# Server-side only — do NOT prefix these with NEXT_PUBLIC.
# Without them, waitlist texts are simulated (the app still works).
# Get these from https://www.twilio.com/console
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
